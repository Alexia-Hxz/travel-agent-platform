DASHSCOPE_API_KEY=
# Planning recommendations, grounded search, budget allocation and final summary.
PLANNING_MODEL_NAME=qwen3.7-plus
# Raw category-search material only. Defaults to 24 hours and survives restarts.
CATEGORY_MATERIAL_CACHE_TTL_HOURS=24
# Set to 1 for one run that must bypass existing entries while refreshing them.
CATEGORY_MATERIAL_CACHE_FORCE_REFRESH=0
# Set to 1 before process startup to clear only this cache once.
CATEGORY_MATERIAL_CACHE_CLEAR=0
# Optional; defaults to backend/data/category_material_cache.sqlite3.
# CATEGORY_MATERIAL_CACHE_PATH=
# The picture source: language model, live web search and this key are the only external
# services the project calls. Using Pexels requires crediting the photographer, which the
# recommendation cards do. Without it, cards fall back to a bundled placeholder.
PEXELS_API_KEY=
# Some networks resolve the Pexels photo host to an address that accepts no connection.
# Search still works and returns photo URLs, but every picture then fails its
# reachability check and each card silently falls back to a bundled placeholder.
# A fallback is only used when the system's own answer for that host is unreachable,
# so a healthy network needs nothing here. Leave empty unless pictures are missing.
# IMAGE_HOST_FALLBACKS=images.pexels.com=104.18.66.220|104.18.67.220|172.64.147.160
